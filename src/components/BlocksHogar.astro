---
// src/components/BlocksHogar.astro
import imgMattBlack from "../assets/categories/hero_fab.jpg";
import imgPerfectPale from "../assets/categories/frigo_beige.jpg";
import imgRust from "../assets/categories/frigo_rust.jpg";
import imgLightBlue from "../assets/categories/frigo_blue.jpg";

import imgInteriorRust from "../assets/categories/interior_rust.jpg";
import imgInteriorBlue from "../assets/categories/interior_blue.png";
import imgInteriorPale from "../assets/categories/interior_pale.jpg";

import imgUnionJack from "../assets/categories/frigo_union_jack.jpg";
import imgItalia from "../assets/categories/frigo_italia.jpg";
import imgDG from "../assets/categories/frigo_dg.jpg";
import imgMulticolor from "../assets/categories/frigo_multicolor.jpg";
import imgSpecial from "../assets/categories/frigo_special.jpg";

import imgYellowAmbient from "../assets/categories/yellow_ambient.jpg";
import imgOrangeGama from "../assets/categories/orange_gama.jpg";
import imgLinesBackground from "../assets/categories/smeg_lines_bg.jpg";

import imgCinemaFilm from "../assets/categories/cinema_film.jpg";

import dataDB from "../../db.json";
const blockContent = dataDB.home.blocks_hogar;
---

<!-- ======================================================== -->
<!-- 1. БЛОК: ПОЛНОЭКРАННЫЙ ГЛАВНЫЙ БАННЕР СЛАЙДЕРА РЕТРО-ХОЛОДИЛЬНИКОВ -->
<!-- ======================================================== -->
<section
  class="w-full mb-13 select-none relative bg-white h-[75vh] lg:h-[88vh] overflow-hidden group/slider"
>
  <!-- КНОПКА СТРЕЛКА ВЛЕВО -->
  <button
    id="btn-hogar-prev"
    class="absolute left-2 md:left-8 top-1/2 -translate-y-1/2 w-12 h-12 md:w-14 md:h-12 rounded-full bg-white/95 shadow-lg border border-neutral-200 flex items-center justify-center text-neutral-800 hover:bg-black hover:text-white transition-all duration-300 z-30 opacity-100 md:opacity-0 md:group-hover/slider:opacity-100 cursor-pointer"
    aria-label="Anterior"
  >
    <svg
      xmlns="http://w3.org"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke="currentColor"
      class="w-5 h-5"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M15.75 19.5 8.25 12l7.5-7.5"></path></svg
    >
  </button>

  <!-- КНОПКА СТРЕЛКА ВПРАВО -->
  <button
    id="btn-hogar-next"
    class="absolute right-2 md:right-8 top-1/2 -translate-y-1/2 w-12 h-12 md:w-14 md:h-12 rounded-full bg-white/95 shadow-lg border border-neutral-200 flex items-center justify-center text-neutral-800 hover:bg-black hover:text-white transition-all duration-300 z-30 opacity-100 md:opacity-0 md:group-hover/slider:opacity-100 cursor-pointer"
    aria-label="Siguiente"
  >
    <svg
      xmlns="http://w3.org"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke="currentColor"
      class="w-5 h-5"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="m8.25 4.5 7.5 7.5-7.5 7.5"></path></svg
    >
  </button>

  <!-- БЕСКОНЕЧНЫЙ ХОЛСТ СЛАЙДОВ -->
  <div
    id="hogar-infinite-canvas"
    class="absolute left-1/2 top-0 -translate-x-1/2 w-[80vw] h-full bg-white"
  >
    <!-- СЛАЙД 1: NEW MATT BLACK -->
    <div
      class="hogar-slide absolute inset-0 w-full h-full flex items-center px-12 md:px-24 rounded-2xl overflow-hidden transition-all duration-700 ease-in-out"
    >
      <img
        src={imgMattBlack.src}
        alt="Smeg FAB Matt Black"
        class="absolute inset-0 w-full h-full object-cover z-0 pointer-events-none"
      />

      <div
        class="absolute right-[10%] bottom-[-15%] w-120 h-120 rounded-full border-4 border-white/10 pointer-events-none z-10 flex items-center justify-center"
      >
        <div
          class="w-[24rem] h-96 rounded-full border-4 border-white/10 flex items-center justify-center"
        >
          <div class="w-72 h-72 rounded-full border-4 border-white/10"></div>
        </div>
      </div>

      <div
        class="z-20 select-none pointer-events-none pt-12"
        style={`color: ${blockContent.slides[0].color};`}
      >
        <span
          class="text-sm font-medium tracking-[0.4em] uppercase block mb-2 opacity-50"
        >
          {blockContent.slides[0].badge}
        </span>
        <h3
          class="text-5xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight leading-none whitespace-normal"
        >
          Matt <br />Black
        </h3>
      </div>
    </div>

    <!-- СЛАЙД 2: NEW PERFECT PALE -->
    <div
      class="hogar-slide absolute inset-0 w-full h-full flex items-center px-12 md:px-24 rounded-2xl overflow-hidden transition-all duration-700 ease-in-out"
    >
      <img
        src={imgPerfectPale.src}
        alt="Smeg FAB Perfect Pale"
        class="absolute inset-0 w-full h-full object-cover z-0 pointer-events-none"
      />

      <div
        class="absolute right-[10%] bottom-[-15%] w-120 h-120 rounded-full border-4 border-white/20 pointer-events-none z-10 flex items-center justify-center"
      >
        <div
          class="w-[24rem] h-96 rounded-full border-4 border-white/20 flex items-center justify-center"
        >
          <div class="w-72 h-72 rounded-full border-4 border-white/20"></div>
        </div>
      </div>

      <div
        class="z-20 select-none pointer-events-none pt-12"
        style={`color: ${blockContent.slides[1].color};`}
      >
        <span
          class="text-sm font-medium tracking-[0.4em] uppercase block mb-2 opacity-70"
        >
          {blockContent.slides[1].badge}
        </span>
        <h3
          class="text-5xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight leading-none whitespace-normal"
        >
          Perfect <br />Pale
        </h3>
      </div>
    </div>

    <!-- СЛАЙД 3: NEW RUST -->
    <div
      class="hogar-slide absolute inset-0 w-full h-full flex items-center px-12 md:px-24 rounded-2xl overflow-hidden transition-all duration-700 ease-in-out"
    >
      <img
        src={imgRust.src}
        alt="Smeg FAB New Rust"
        class="absolute inset-0 w-full h-full object-cover z-0 pointer-events-none"
      />

      <div
        class="absolute right-[10%] bottom-[-15%] w-120 h-120 rounded-full border-4 border-white/20 pointer-events-none z-10 flex items-center justify-center"
      >
        <div
          class="w-[24rem] h-96 rounded-full border-4 border-white/20 flex items-center justify-center"
        >
          <div class="w-72 h-72 rounded-full border-4 border-white/20"></div>
        </div>
      </div>

      <div
        class="z-20 select-none pointer-events-none pt-12"
        style={`color: ${blockContent.slides[2].color};`}
      >
        <span
          class="text-sm font-medium tracking-[0.4em] uppercase block mb-2 opacity-70"
        >
          {blockContent.slides[2].badge}
        </span>
        <h3
          class="text-5xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight leading-none whitespace-normal"
        >
          {blockContent.slides[2].title}
        </h3>
      </div>
    </div>

    <!-- СЛАЙД 4: NEW LIGHT BLUE -->
    <div
      class="hogar-slide absolute inset-0 w-full h-full flex items-center px-8 sm:px-12 md:px-24 rounded-2xl overflow-hidden transition-all duration-700 ease-in-out"
    >
      <img
        src={imgLightBlue.src}
        alt="Smeg FAB Light Blue"
        class="absolute inset-0 w-full h-full object-cover z-0 pointer-events-none"
      />

      <div
        class="absolute right-[10%] bottom-[-15%] w-120 h-120 rounded-full border-4 border-white/20 pointer-events-none z-10 flex items-center justify-center"
      >
        <div
          class="w-[24rem] h-96 rounded-full border-4 border-white/20 flex items-center justify-center"
        >
          <div class="w-72 h-72 rounded-full border-4 border-white/20"></div>
        </div>
      </div>

      <div
        class="z-20 select-none pointer-events-none pt-12 max-sm:pl-4"
        style={`color: ${blockContent.slides[3].color};`}
      >
        <span
          class="text-sm font-medium tracking-[0.4em] uppercase block mb-2 opacity-70"
        >
          {blockContent.slides[3].badge}
        </span>
        <h3
          class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight leading-none whitespace-normal"
        >
          {blockContent.slides[3].title}
        </h3>
      </div>
    </div>
  </div>
</section>

<!-- ======================================================== -->
<!-- 2 БЛОК: МАРКЕТИНГОВЫЙ ТЕКСТ И ТРЁХКОЛОНОЧНАЯ СЕТКА ИНТЕРЬЕРОВ -->
<!-- ======================================================== -->
<section class="w-full bg-white py-12 px-6 md:px-12 select-none text-center">
  <div class="max-w-[1600px] mx-auto space-y-16">
    <!-- 1. ЦЕНТРАЛЬНЫЙ ТЕКСТ -->
    <div class="max-w-4xl mx-auto">
      <p
        class="text-neutral-800 text-xl sm:text-2xl lg:text-[28px] font-light tracking-wide leading-[1.6]"
      >
        {blockContent.marketing_central.description}
      </p>
    </div>

    <!-- 2. СЕТКА ИЗ 3-Х СТИЛЬНЫХ ФОТОГРАФИЙ КУХНИ -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      <!-- Колонка 1: Интерьер с ржавым холодильником -->
      <div
        class="w-full aspect-4/5 overflow-hidden rounded-2xl shadow-2xs border border-neutral-100 group cursor-pointer"
      >
        <img
          src={imgInteriorRust.src}
          alt="Ambiente Frigorífico ÁNIMA FAB Rust"
          class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.02]"
        />
      </div>

      <!-- Колонка 2: Интерьер с лазурно-голубым холодильником -->
      <div
        class="w-full aspect-4/5 overflow-hidden rounded-2xl shadow-2xs border border-neutral-100 group cursor-pointer"
      >
        <img
          src={imgInteriorBlue.src}
          alt="Ambiente Frigorífico ÁNIMA FAB Light Blue"
          class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.02]"
        />
      </div>

      <!-- Колонка 3: Интерьер с бежевым холодильником -->
      <div
        class="w-full aspect-4/5 overflow-hidden rounded-2xl shadow-2xs border border-neutral-100 group cursor-pointer"
      >
        <img
          src={imgInteriorPale.src}
          alt="Ambiente Frigorífico ÁNIMA FAB Perfect Pale"
          class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.02]"
        />
      </div>
    </div>
  </div>
</section>

<!-- ======================================================== -->
<!-- 3. БЛОК: UNA HISTORIA DE COLOR (КИНО-ПАНОРАМА)           -->
<!-- ======================================================== -->
<section
  class="w-full mt-12 mb-0 select-none overflow-hidden relative left-0 right-0 h-auto lg:h-[105vh] aspect-4/5 sm:aspect-video lg:aspect-auto bg-black z-10 js-video-wrapper"
>
  <div
    class="w-full h-full relative bg-black border-0 lg:border-t-65 lg:border-b-65 border-black transition-all duration-300
    **:[::-webkit-media-controls-panel]:opacity-0
    **:[::-webkit-media-controls-panel]:transition-opacity
    **:[::-webkit-media-controls-panel]:duration-500
    hover:**:[::-webkit-media-controls-panel]:opacity-100"
  >
    <div
      class="js-video-shield absolute inset-0 w-full h-full z-10 bg-transparent"
      style="pointer-events: none;"
    >
    </div>

    <video
      id="hogar-video-player"
      class="js-video-iframe w-full h-full object-cover opacity-95 relative z-0 cursor-pointer"
      style="pointer-events: auto;"
      src="/video/fab-history.mp4"
      autoplay
      muted
      loop
      playsinline
      controls
    >
    </video>
  </div>
</section>

<!-- ======================================================== -->
<!-- 4. БЛОК: ТЕКСТ СЛЕВА + СЛАЙДЕР ИЗ 5 ФОТО       -->
<!-- ======================================================== -->
<section
  class="w-full min-h-[60vh] lg:h-[85vh] grid grid-cols-1 lg:grid-cols-2 select-none overflow-hidden bg-white left-0 right-0 mt-12 sm:mt-24"
>
  <!-- ЛЕВАЯ КОЛОНКА: ТЕКСТ НА ФОНЕ -->
  <div
    class="w-full h-full flex flex-col justify-center items-center px-12 md:px-20 lg:px-24 py-12 lg:py-0 text-center relative order-2 lg:order-1"
    style="background-color: #d9d3c7;"
  >
    <!-- Декоративные круги -->
    <div
      class="absolute left-[-5%] bottom-[-10%] w-80 h-80 rounded-full border-2 border-white/20 pointer-events-none z-0 flex items-center justify-center"
    >
      <div
        class="w-64 h-64 rounded-full border-2 border-white/20 flex items-center justify-center"
      >
        <div class="w-44 h-44 rounded-full border-2 border-white/20"></div>
      </div>
    </div>

    <!-- Контейнер с текстом -->
    <div
      class="space-y-6 max-w-md lg:max-w-lg relative z-10 text-neutral-900 mx-auto"
    >
      <h2
        class="text-3xl sm:text-4xl lg:text-[38px] font-light tracking-wide uppercase leading-tight whitespace-normal"
      >
        {blockContent.vestidos.title}
      </h2>

      <p
        class="text-neutral-800 text-[16px] sm:text-[17px] font-light tracking-wide leading-[1.9] opacity-90"
      >
        {blockContent.vestidos.description}
      </p>
    </div>
  </div>

  <!-- ПРАВАЯ СТОРОНА: СЛАЙДЕР НА ВСЮ ПОЛОВИНУ ЭКРАНА БЕЗ РАМОК И ОТСТУПОВ -->
  <div
    class="w-full h-full relative bg-[#f6f6f6] min-h-125 lg:min-h-0 group/vestidos order-1 lg:order-2"
  >
    <!-- Стрелка влево -->
    <button
      id="btn-vestidos-prev"
      class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/95 shadow-md border border-neutral-200 flex items-center justify-center text-neutral-800 hover:bg-black hover:text-white transition-all duration-300 z-30 opacity-100 md:opacity-0 md:group-hover/vestidos:opacity-100 cursor-pointer"
      aria-label="Anterior"
    >
      <svg
        xmlns="http://w3.org"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="w-4 h-4"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15.75 19.5 8.25 12l7.5-7.5"></path></svg
      >
    </button>

    <!-- Стрелка вправо -->
    <button
      id="btn-vestidos-next"
      class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/95 shadow-md border border-neutral-200 flex items-center justify-center text-neutral-800 hover:bg-black hover:text-white transition-all duration-300 z-30 opacity-100 md:opacity-0 md:group-hover/vestidos:opacity-100 cursor-pointer"
      aria-label="Siguiente"
    >
      <svg
        xmlns="http://w3.org"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="w-4 h-4"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m8.25 4.5 7.5 7.5-7.5 7.5"></path></svg
      >
    </button>

    <div id="vestidos-slides-container" class="relative w-full h-full">
      <div
        class="vestidos-slide opacity-100 z-10 absolute inset-0 w-full h-full transition-all duration-700 ease-in-out"
      >
        <img
          src={imgUnionJack.src}
          alt="Smeg"
          class="w-full h-full object-cover object-center select-none pointer-events-none"
        />
      </div>
      <div
        class="vestidos-slide opacity-0 z-0 absolute inset-0 w-full h-full transition-all duration-700 ease-in-out"
      >
        <img
          src={imgItalia.src}
          alt="Smeg"
          class="w-full h-full object-cover object-center select-none pointer-events-none"
        />
      </div>
      <div
        class="vestidos-slide opacity-0 z-0 absolute inset-0 w-full h-full transition-all duration-700 ease-in-out"
      >
        <img
          src={imgDG.src}
          alt="Smeg"
          class="w-full h-full object-cover object-center select-none pointer-events-none"
        />
      </div>
      <div
        class="vestidos-slide opacity-0 z-0 absolute inset-0 w-full h-full transition-all duration-700 ease-in-out"
      >
        <img
          src={imgMulticolor.src}
          alt="Smeg"
          class="w-full h-full object-cover object-center select-none pointer-events-none"
        />
      </div>
      <div
        class="vestidos-slide opacity-0 z-0 absolute inset-0 w-full h-full transition-all duration-700 ease-in-out"
      >
        <img
          src={imgSpecial.src}
          alt="Smeg"
          class="w-full h-full object-cover object-center select-none pointer-events-none"
        />
      </div>
    </div>
  </div>
</section>

<!-- ======================================================== -->
<!-- 5.БЛОК: ФОТО ИНТЕРЬЕРА СЛЕВА + ЖЕЛТЫЙ ТЕКСТ СПРАВА       -->
<!-- ======================================================== -->
<section
  class="w-full min-h-[60vh] lg:h-[85vh] grid grid-cols-1 lg:grid-cols-2 select-none overflow-hidden bg-white left-0 right-0"
>
  <!-- ЛЕВАЯ ПОЛОВИНА: ФОТО ИНТЕРЬЕРА -->
  <div class="w-full h-full relative aspect-4/3 lg:min-h-0">
    <img
      src={imgYellowAmbient.src}
      alt="Ambiente Frigorífico Amarillo ÁNIMA"
      class="w-full h-full object-cover object-center select-none pointer-events-none"
    />
  </div>

  <!-- ПРАВАЯ ПОЛОВИНА: ТЕКСТ НА ЖЕЛТОМ ФOНЕ -->
  <div
    class="w-full h-full flex flex-col justify-center items-center px-12 md:px-20 lg:px-24 py-12 lg:py-0 text-center relative"
    style="background-color: #daa001;"
  >
    <div
      class="absolute right-[-5%] bottom-[-10%] w-80 h-80 rounded-full border-2 border-white/20 pointer-events-none z-0 flex items-center justify-center"
    >
      <div
        class="w-64 h-64 rounded-full border-2 border-white/20 flex items-center justify-center"
      >
        <div class="w-44 h-44 rounded-full border-2 border-white/20"></div>
      </div>
    </div>

    <div
      class="space-y-6 max-w-md lg:max-w-lg relative z-10 text-neutral-900 mx-auto"
    >
      <h2
        class="text-3xl sm:text-4xl lg:text-[38px] font-light tracking-wide uppercase leading-tight whitespace-normal"
      >
        {blockContent.colaboraciones.title}
      </h2>

      <p
        class="text-neutral-800 text-[15px] sm:text-[17px] font-light tracking-wide leading-[1.9] opacity-90"
      >
        {blockContent.colaboraciones.description}
      </p>

      <!--<div class="pt-6 flex justify-center">
        <a 
          href="/noticias/colaboraciones" 
          class="inline-flex items-center gap-4 text-[11px] font-bold tracking-[0.2em] text-neutral-900 uppercase group"
        >
          <span class="w-8 h-px bg-neutral-900 group-hover:w-12 transition-all duration-300"></span>
          {blockContent.colaboraciones.button}
        </a>
      </div>-->
    </div>
  </div>
</section>

<!-- ======================================================== -->
<!-- 6.БЛОК: ОРАНЖЕВЫЙ ТЕКСТ СЛЕВА + ТРИ ХОЛОДИЛЬНИКА СПРАВА -->
<!-- ======================================================== -->
<section
  class="w-full min-h-[60vh] lg:h-[85vh] grid grid-cols-1 lg:grid-cols-2 select-none overflow-hidden bg-white left-0 right-0"
>
  <!-- ЛЕВАЯ ПОЛОВИНА: ТЕКСТ НА ОРАНЖЕВОМ ФОНЕ -->
  <div
    class="order-2 lg:order-1 w-full h-full flex flex-col justify-center items-center px-12 md:px-20 lg:px-24 py-12 lg:py-0 text-center relative"
    style="background-color: #b06243;"
  >
    <div
      class="absolute left-[-5%] top-[-10%] w-80 h-80 rounded-full border-2 border-white/20 pointer-events-none z-0 flex items-center justify-center"
    >
      <div
        class="w-64 h-64 rounded-full border-2 border-white/20 flex items-center justify-center"
      >
        <div class="w-44 h-44 rounded-full border-2 border-white/20"></div>
      </div>
    </div>

    <div
      class="space-y-6 max-w-md lg:max-w-lg relative z-10 text-neutral-900 mx-auto"
    >
      <h2
        class="text-3xl sm:text-4xl lg:text-[38px] font-light tracking-wide uppercase leading-tight text-white whitespace-normal"
      >
        {blockContent.gama_amplia.title}
      </h2>
      <p
        class="text-neutral-100 text-[15px] sm:text-[17px] font-light tracking-wide leading-[1.9] opacity-90"
      >
        {blockContent.gama_amplia.description}
      </p>
    </div>
  </div>

  <!-- ПРАВАЯ ПОЛОВИНА: ФОТО С ТРЕМЯ ОРАНЖЕВЫМИ ХОЛОДИЛЬНИКАМИ -->
  <div class="order-1 lg:order-2 w-full h-full relative aspect-4/3 lg:min-h-0">
    <img
      src={imgOrangeGama.src}
      alt="Gama de frigoríficos naranjas ÁNIMA FAB"
      class="w-full h-full object-cover object-center select-none pointer-events-none"
    />
  </div>
</section>

<!-- ======================================================== -->
<!-- 7. БЛОК: TECNOLOGÍA DE REFRIGERACIÓN                     -->
<!-- ======================================================== -->
<section
  class="w-full bg-white mt-12 md:mt-24 mb-8 md:mb-16 select-none relative overflow-hidden left-0 right-0 h-auto"
>
  <img
    src={imgLinesBackground.src}
    alt="Tecnología de refrigeración ÁNIMA FAB"
    class="w-full h-auto object-cover select-none block pointer-events-none"
  />
</section>

<!-- ======================================================== -->
<!-- 8. БЛОК: EN EL PUNTO DE MIRA (РОЗОВЫЙ)                   -->
<!-- ======================================================== -->
<section
  class="w-full -mt-4 sm:-mt-20 grid grid-cols-1 lg:grid-cols-2 select-none overflow-hidden bg-white left-0 right-0 relative z-20"
>
  <!-- ЛЕВАЯ ПОЛОВИНА: КИНОПЛЕНКА -->
  <div
    class="w-full h-full relative aspect-4/3 lg:min-h-0 bg-[#141414] flex items-center justify-center"
  >
    <img
      src={imgCinemaFilm.src}
