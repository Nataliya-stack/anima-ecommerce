---
// src/pages/perfil.astro
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase";

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

let user = null;

if (accessToken && refreshToken) {
  const { data } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });
  if (data.user) {
    user = data.user;
  }
}

if (!user) {
  return Astro.redirect("/login");
}
---

<Layout title="Editar Perfil | ÁNIMA">
  <main
    class="w-full min-h-screen bg-white text-neutral-900 pt-35 lg:pt-50 font-sans pb-32 select-none"
  >
    <!-- Навигационная стрелка -->
    <div class="w-full max-w-[1700px] mx-auto px-6 sm:px-12 lg:px-20 mb-8">
      <nav
        class="text-[14px] lg:tracking-[0.2em] text-neutral-400 uppercase font-light font-sans select-none flex items-center gap-2"
      >
        <a
          href="/"
          class="hover:text-black transition-colors flex items-center gap-1"
        >
          ← Página principal
        </a>
        <span class="mx-1">/</span>
        <a href="/login" class="hover:text-black transition-colors">
          Mi Cuenta
        </a>
        <span class="mx-1">/</span>
        <span class="text-neutral-800 font-normal">Editar Perfil</span>
      </nav>
    </div>

    <!-- ======================================================= -->
    <!-- 1. СЕКЦИЯ ФОРМЫ РЕДАКТИРОВАНИЯ ПРОФИЛЯ -->
    <!-- ======================================================= -->
    <section class="w-full max-w-[1700px] mx-auto px-6 sm:px-12 lg:px-20">
      <div class="max-w-3xl w-full flex flex-col space-y-12">
        <div class="space-y-2">
          <p
            class="text-xs tracking-[0.2em] uppercase text-neutral-400 font-semibold"
          >
            Configuración de cuenta
          </p>
          <h2
            class="text-3xl md:text-4xl font-light tracking-wide text-black uppercase"
          >
            Detalles del Perfil
          </h2>
        </div>

        <!-- ФОРМА С ПОЛНЫМ НАБОРОМ ПОЛЕЙ -->
        <form
          action="/api/clientes/crear"
          method="POST"
          class="max-w-xl w-full flex flex-col space-y-8 pt-4"
        >
          <!-- ПОЛЕ: ИМЯ -->
          <label class="flex flex-col space-y-2">
            <span
              class="text-neutral-900 uppercase text-xs font-bold tracking-[0.15em]"
              >Nombre *</span
            >
            <input
              type="text"
              name="nombre"
              required
              placeholder="Tu nombre"
              class="border-2 border-neutral-400 p-4 w-full text-base font-light text-black bg-neutral-50 focus:outline-none focus:border-black transition-colors rounded-none"
            />
          </label>

          <!-- ПОЛЕ: ПЕРВАЯ ФАМИЛИЯ -->
          <label class="flex flex-col space-y-2">
            <span
              class="text-neutral-900 uppercase text-xs font-bold tracking-[0.15em]"
              >Primer Apellido *</span
            >
            <input
              type="text"
              name="apellido1"
              required
              placeholder="Tu primer apellido"
              class="border-2 border-neutral-400 p-4 w-full text-base font-light text-black bg-neutral-50 focus:outline-none focus:border-black transition-colors rounded-none"
            />
          </label>

          <!-- ПОЛЕ: ВТОРАЯ ФАМИЛИЯ -->
          <label class="flex flex-col space-y-2">
            <span
              class="text-neutral-900 uppercase text-xs font-bold tracking-[0.15em]"
              >Segundo Apellido</span
            >
            <input
              type="text"
              name="apellido2"
              placeholder="Tu segundo apellido (opcional)"
              class="border-2 border-neutral-400 p-4 w-full text-base font-light text-black bg-neutral-50 focus:outline-none focus:border-black transition-colors rounded-none"
            />
          </label>

          <!-- ПОЛЕ: ТЕЛЕФОН -->
          <label class="flex flex-col space-y-2">
            <span
              class="text-neutral-900 uppercase text-xs font-bold tracking-[0.15em]"
              >Teléfono de contacto</span
            >
            <input
              type="tel"
              name="telefono"
              placeholder="+34 600 000 000"
              class="border-2 border-neutral-400 p-4 w-full text-base font-light text-black bg-neutral-50 focus:outline-none focus:border-black transition-colors rounded-none"
            />
          </label>

          <input type="hidden" name="email" value={user.email} />
          <input type="hidden" name="enviar-brevo" value="false" />

          <div class="pt-4">
            <button
              type="submit"
              class="w-full md:w-auto bg-black border border-black text-white text-xs tracking-[0.2em] uppercase font-bold py-4.5 px-12 hover:bg-neutral-800 transition-all duration-300 cursor-pointer text-center"
            >
              Guardar Registro
            </button>
          </div>
        </form>
      </div>
    </section>
  </main>
</Layout>
