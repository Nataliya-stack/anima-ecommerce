---
// src/pages/special.astro
import Layout from '../layouts/Layout.astro';
import dataDB from '../../db.json';

import porscheSlide1 from '../assets/categories/porsche-1.png';
import porscheSlide2 from '../assets/categories/porsche-2.jpg';
import porscheSlide3 from '../assets/categories/porsche-3.jpg';
import artFridgeImg from '../assets/categories/frigorifico-arte.jpg';
import sicilyImg from '../assets/categories/sicily-is-my-love.jpg';
import divina1 from '../assets/categories/divina-cucina-1.jpg'; 
import divina2 from '../assets/categories/divina-cucina-2.jpg'; 

const porscheImages = [porscheSlide1, porscheSlide2, porscheSlide3];
const slides = dataDB.specialProjectsSlider || [];

const divinaImages = [divina1, divina2];
const divinaSlides = dataDB.divinaCucinaSlider || [];
---

<Layout title="Los especiales de Smeg | ÁNIMA">
  <main class="w-full bg-white text-neutral-900 min-h-screen pt-28 lg:pt-50 pb-24">
    
    <div class="max-w-[1700px] mx-auto px-6 sm:px-12 lg:px-20 mb-16 lg:mb-20">
      
      <!-- Навигационные стрелки -->
      <nav class="text-xs tracking-widest text-neutral-400 mb-8 font-light">
        <a href="/" class="hover:text-neutral-900 transition-colors">Página principal</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-600">Proyectos especiales</span>
      </nav>

      <!-- Блок с тонкой вертикальной линией слева -->
      <div class="max-w-4xl border-l border-neutral-300 pl-6 sm:pl-8 space-y-4">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-light tracking-normal text-neutral-900">
          Los especiales de Smeg
        </h1>
        <p class="text-neutral-600 text-sm sm:text-base font-light tracking-wide leading-relaxed max-w-3xl">
          Smeg siempre ha colaborado con importantes e influyentes marcas del mundo de la alta moda, el arte y el diseño, con las que crea electrodomésticos de diseño único y vanguardista.
        </p>
      </div>

    </div>

    <!-- СЕКЦИЯ СЛАЙДЕРА -->
    <section class="w-full py-12 lg:py-20 border-t border-neutral-100">
      <div class="js-slider-container max-w-[1700px] mx-auto px-6 sm:px-12 lg:px-20 relative min-h-112.5">

        <!-- Кнопка «Назад» -->
        <button 
          type="button"
          class="js-btn-prev absolute left-2 lg:left-6 top-1/2 -translate-y-1/2 z-30 w-10 h-10 lg:w-12 lg:h-12 rounded-full bg-black/80 flex items-center justify-center text-white hover:bg-black transition-colors cursor-pointer shadow-md"
          aria-label="Anterior"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path></svg>
        </button>

        <!-- Кнопка «Вперед» -->
        <button 
          type="button"
          class="js-btn-next absolute right-2 lg:right-6 top-1/2 -translate-y-1/2 z-30 w-10 h-10 lg:w-12 lg:h-12 rounded-full bg-black/80 flex items-center justify-center text-white hover:bg-black transition-colors cursor-pointer shadow-md"
          aria-label="Siguiente"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path></svg>
        </button>

        <!-- Оболочка слайдов (данные берутся из db.json через map) -->
        <div class="relative w-full min-h-112.5">
          
          {slides.map((slide, index) => {
            const currentImg = porscheImages[index] || porscheImages[0];
            return (
              <div 
                class={`js-slide-item absolute inset-0 w-full transition-opacity duration-700 ease-in-out grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center px-4 lg:px-12 ${
                  index === 0 ? 'opacity-100 z-10' : 'opacity-0 pointer-events-none z-0'
                }`}
              >
                <!-- Левая колонка: Слайдер картинок -->
                <div class="lg:col-span-7 bg-white flex items-center justify-center overflow-hidden">
                  <img 
                    src={currentImg.src} 
                    alt={slide.title} 
                    class="w-full h-70 sm:h-90 object-contain block lg:hidden" 
                  />
                  <img 
                    src={currentImg.src} 
                    alt={slide.title} 
                    class="w-full h-auto max-h-130 object-contain hidden lg:block" 
                  />
                </div>

                <!-- Правая колонка: Текст из db.json -->
                <div class="lg:col-span-5 space-y-6 max-w-lg">
                  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-light tracking-wide text-neutral-900">
                    {slide.title}
                  </h2>
                  
                  <p class="text-neutral-600 text-sm sm:text-base font-light tracking-wide leading-relaxed">
                    {slide.description}
                  </p>

                  <div class="pt-2">
                    <a 
                      href={slide.buttonLink} 
                      class="inline-block border-b border-neutral-900 pb-0.5 text-xs uppercase font-bold tracking-[0.2em] text-neutral-900 hover:opacity-60 transition-opacity"
                    >
                      {slide.buttonText}
                    </a>
                  </div>
                </div>

              </div>
            );
          })}

        </div>

      </div>
    </section>

    <section class="w-full py-16 lg:py-24 border-t border-neutral-100 bg-white">
        <div class="max-w-[1700px] mx-auto px-6 sm:px-12 lg:px-20">
    
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
                <!-- ЛЕВАЯ КОЛОНКА: Текст (5 колонок) -->
                <div class="lg:col-span-5 space-y-6 max-w-lg">
                    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light tracking-wide text-neutral-900">
                        Frigorífico de Arte
                    </h2>
        
                    <p class="text-neutral-600 text-sm sm:text-base font-light tracking-wide leading-relaxed">
                        Los temas desarrollados en cada producto se embellecen con motivos florales. Estos <strong class="font-normal text-neutral-900">100 frigoríficos exclusivos</strong> –resultado de la innovación y la meticulosa atención al detalle– son productos únicos que combinan <strong class="font-normal text-neutral-900">la calidad y la tecnología Smeg con la creatividad y los maestros artesanos de Dolce&Gabbana</strong>.
                    </p>

                    <!-- <div class="pt-2">
                        <a 
                        href="#" 
                        class="inline-flex items-center gap-4 text-xs uppercase font-bold tracking-[0.2em] text-neutral-900 hover:opacity-60 transition-opacity"
                        >
                            <span class="w-8 h-px bg-neutral-900"></span>
                                VER LA COLECCIÓN
                        </a>
                    </div>-->
                </div>

                <!-- ПРАВАЯ КОЛОНКА: Изображение холодильника (7 колонок) -->
                <div class="lg:col-span-7 bg-white flex items-center justify-center overflow-hidden">
                    <img 
                    src={artFridgeImg.src} 
                    alt="Frigorífico de Arte - Dolce & Gabbana" 
                    class="w-full h-75 sm:h-100 lg:h-130 object-cover rounded-sm shadow-sm" 
                    />
                </div>

            </div>

        </div>
    </section>

    <!-- СЕКЦИЯ: LA COLECCIÓN SICILY IS MY LOVE -->
    <section class="w-full py-16 lg:py-24 border-t border-neutral-100 bg-white">
        <div class="max-w-[1700px] mx-auto px-6 sm:px-12 lg:px-20">
    
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
                <!-- ЛЕВАЯ КОЛОНКА: Картинка (7 колонок) -->
                <div class="lg:col-span-7 bg-white flex items-center justify-center overflow-hidden">
                    <img 
                    src={sicilyImg.src} 
                    alt="La colección Sicily is my love" 
                    class="w-full h-auto max-h-145 object-contain rounded-sm" 
                    />
                </div>

                <!-- ПРАВАЯ КОЛОНКА: Текст (5 колонок) -->
                <div class="lg:col-span-5 space-y-6 max-w-lg">
                    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light tracking-wide text-neutral-900 leading-tight">
                        La colección Sicily is my love
                    </h2>
        
                    <p class="text-neutral-600 text-sm sm:text-base font-light tracking-wide leading-relaxed">
                        La colección del pequeño electrodoméstico de Smeg con el inconfundible toque de <strong class="font-normal text-neutral-900">Dolce&Gabbana</strong> son símbolos de una estética intrínsecamente asociada con Sicilia, hogar de las almas de Domenico Dolce y Stefano Gabbana, de la que Smeg siempre ha sido un excelente intérprete. Tostadoras, exprimidores de cítricos, máquinas de café, hervidoras, batidoras, robots de cocina y licuadoras, todos decorados con limones dorados, frutas cítricas, peras y brillantes cerezas rojas, algunos de los <strong class="font-normal text-neutral-900">decorados Sicilianos más tradicionales</strong> enmarcados en motivos triangulares.
                    </p>

                     <!--<div class="pt-2">
                        <a 
                        href="#" 
                        class="inline-flex items-center gap-4 text-xs uppercase font-bold tracking-[0.2em] text-neutral-900 hover:opacity-60 transition-opacity"
                        >
                            <span class="w-8 h-px bg-neutral-900"></span>
                                EXPLORA LA COLECCIÓN
                        </a>
                    </div>-->
                </div>

            </div>

        </div>
    </section>

    <!-- СЕКЦИЯ: DIVINA CUCINA (Слайдер: текст слева, картинка справа) -->
    <section class="w-full py-16 lg:py-24 border-t border-neutral-100 bg-white">
        <div class="js-slider-container max-w-[1700px] mx-auto px-6 sm:px-12 lg:px-20 relative min-h-120">

            <!-- Кнопка «Назад» -->
            <button 
                type="button"
                class="js-btn-prev absolute left-2 lg:left-6 top-1/2 -translate-y-1/2 z-30 w-10 h-10 lg:w-12 lg:h-12 rounded-full bg-black/80 flex items-center justify-center text-white hover:bg-black transition-colors cursor-pointer shadow-md"
                aria-label="Anterior"
                >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path></svg>
            </button>

            <!-- Кнопка «Вперед» -->
            <button 
                type="button"
                class="js-btn-next absolute right-2 lg:right-6 top-1/2 -translate-y-1/2 z-30 w-10 h-10 lg:w-12 lg:h-12 rounded-full bg-black/80 flex items-center justify-center text-white hover:bg-black transition-colors cursor-pointer shadow-md"
                aria-label="Siguiente"
                >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path></svg>
            </button>

            <!-- Оболочка слайдов -->
            <div class="relative w-full min-h-120">
      
                {divinaSlides.map((slide, index) => {
                const currentImg = divinaImages[index] || divinaImages[0];
                return (
                <div 
                    class={`js-slide-item absolute inset-0 w-full transition-opacity duration-700 ease-in-out grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center px-4 lg:px-12 ${
                    index === 0 ? 'opacity-100 z-10' : 'opacity-0 pointer-events-none z-0'
                    }`}
                    >
                    <!-- ЛЕВАЯ КОЛОНКА: Текст (5 колонок) -->
                    <div class="lg:col-span-5 space-y-6 max-w-lg">
                        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light tracking-wide text-neutral-900 leading-tight">
                            {slide.title}
                        </h2>
              
                        <p class="text-neutral-600 text-sm sm:text-base font-light tracking-wide leading-relaxed">
                            {slide.description}
                        </p>

                         <!--<div class="pt-2">
                                <a 
                                href={slide.buttonLink} 
                                class="inline-flex items-center gap-4 text-xs uppercase font-bold tracking-[0.2em] text-neutral-900 hover:opacity-60 transition-opacity"
                                >
                                <span class="w-8 h-px bg-neutral-900"></span>
                                {slide.buttonText}
                            </a>
                        </div>-->
                    </div>

                    <!-- ПРАВАЯ КОЛОНКА: Слайдер картинок (7 колонок) -->
                    <div class="lg:col-span-7 bg-white flex items-center justify-center overflow-hidden">
                        <img 
                        src={currentImg.src} 
                        alt={slide.title} 
                        class="w-full h-70 sm:h-95 object-contain block lg:hidden" 
                        />   
                        <img 
                        src={currentImg.src} 
                        alt={slide.title} 
                        class="w-full h-auto max-h-137.5 object-contain hidden lg:block" 
                        />  
                    </div>

                </div>
                );
                })}
            </div>

        </div>
    </section>

  </main>
  
<script src="../scripts/universalCarousel.js"></script>
</Layout>

