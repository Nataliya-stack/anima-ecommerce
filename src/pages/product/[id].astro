---
// src/pages/product/[id].astro
import Layout from '../../layouts/Layout.astro';
import { obtenerProductoPorId } from '../../lib/productos';

const { id } = Astro.params;
const idNumerico = Number(id) || 1;
const producto = await obtenerProductoPorId(idNumerico);
const hayStock = producto && producto.stock > 0;
---

<Layout title={producto ? `${producto.nombre_producto} | ÁNIMA` : "Producto | ÁNIMA"}>
  <main class="w-full min-h-screen bg-[#ffffff] text-neutral-900 pt-56 pb-24 select-none">
    
    {producto && (
      <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        
        <!-- Контейнер фотографии прибора с кнопкой избранного поверх -->
        <div class="relative w-full aspect-square bg-[#f5f5f5] rounded-3xl overflow-hidden flex items-center justify-center p-12 border border-neutral-100">
          <img 
            src={producto.url_imagen} 
            alt={producto.nombre_producto} 
            class="max-h-full max-w-full object-contain mix-blend-multiply"
          />

          <!-- Кнопка Добавить в избранное (Сердечко) -->
          <button 
            type="button"
            class="wishlist-btn absolute top-6 right-6 w-12 h-12 bg-white/80 backdrop-blur-md rounded-full flex items-center justify-center text-neutral-700 hover:text-red-600 shadow-sm transition-all duration-300 cursor-pointer"
            data-id={producto.pk_producto}
            aria-label="Añadir a lista de deseos"
          >
            <svg class="wishlist-icon w-6 h-6 transition-transform active:scale-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </button>
        </div>

        <!-- Информация о товаре (остальной ваш код без изменений) -->
        <div class="flex flex-col text-left space-y-6 max-w-md">
          <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 tracking-tight">
            {producto.nombre_producto}
          </h1>

          <div class="text-neutral-600 text-sm sm:text-base font-light tracking-wide leading-relaxed space-y-2">
            <p>{producto.descripcion_producto}</p>
            <p class="text-xs text-neutral-400 mt-2 font-mono uppercase tracking-widest">
              Referencia: {producto.pk_producto}
            </p>
          </div>

          <div class="pt-4 border-t border-neutral-100 flex items-center justify-between">
            <div>
              <span class="text-3xl font-bold text-neutral-900 font-mono">
                {producto.precio} €
              </span>
              <span class="text-xs text-neutral-400 block mt-1">
                21% IVA incluido
              </span>
            </div>

            <div>
              {hayStock ? (
                <span class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold uppercase tracking-wider rounded-full border border-emerald-200">
                  En stock ({producto.stock} disp.)
                </span>
              ) : (
                <span class="inline-block px-3 py-1 bg-red-50 text-red-700 text-xs font-bold uppercase tracking-wider rounded-full border border-red-200">
                  Agotado
                </span>
              )}
            </div>
          </div>

          {hayStock ? (
            <>
              <div class="flex items-center gap-4 pt-4">
                <span class="text-sm font-medium text-neutral-700">Cantidad:</span>
                <div class="flex items-center border border-neutral-200 rounded-lg overflow-hidden bg-neutral-50">
                  <button id="btn-menos" class="px-3 py-1.5 hover:bg-neutral-200 transition-colors font-mono cursor-pointer">-</button>
                  <span id="cantidad-display" class="px-4 py-1.5 text-sm font-semibold bg-white border-x border-neutral-200 min-w-10 text-center" data-max-stock={producto.stock}>1</span>
                  <button id="btn-mas" class="px-3 py-1.5 hover:bg-neutral-200 transition-colors font-mono cursor-pointer">+</button>
                </div>
              </div>

              <div class="pt-6">
                <button 
                  id="btn-add-cesta"
                  data-id={producto.pk_producto}
                  data-nombre={producto.nombre_producto}
                  data-precio={producto.precio}
                  data-imagen={producto.url_imagen}
                  data-stock={producto.stock}
                  class="w-full bg-black text-white text-xs uppercase font-bold tracking-widest py-4 px-8 rounded-full hover:bg-neutral-800 transition-colors shadow-sm cursor-pointer"
                >
                  Añadir a la cesta
                </button>
              </div>
            </>
          ) : (
            <div class="pt-6">
              <button 
                disabled
                class="w-full bg-neutral-200 text-neutral-400 text-xs uppercase font-bold tracking-widest py-4 px-8 rounded-full cursor-not-allowed"
              >
                Sin stock disponible
              </button>
            </div>
          )}

        </div>

      </div>
    )}

  </main>

  <script src="../../scripts/cart.js"></script>
  <script src="../../scripts/favorites.js"></script>
</Layout>