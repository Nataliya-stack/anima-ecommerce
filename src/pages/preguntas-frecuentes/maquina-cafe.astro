---
import Layout from '../../layouts/Layout.astro';
import dataDB from '../../../db.json';

const questions = dataDB.faqEGF03;
---

<Layout title="Máquina de Café Espresso Manual con Molinillo Integrado EGF03 - FAQ | ÁNIMA">
  <main class="w-full bg-[#0b0b0b] text-white min-h-screen py-20 lg:py-40 px-6 sm:px-12 lg:px-20">
    <div class="max-w-300 mx-auto space-y-12">
      
      <!-- Навигационные стрелки -->
      <nav class="text-xs text-neutral-400 flex items-center space-x-2 font-light tracking-wide">
        <a href="/" class="hover:text-white transition-colors">Página principal</a>
        <span>/</span>
        <a href="/preguntas-frecuentes" class="hover:text-white transition-colors">Preguntas frecuentes</a>
        <span>/</span>
        <span class="text-neutral-200">Máquina de café espresso manual con molinillo integrado</span>
      </nav>

      <!-- Главный заголовок с левой вертикальной линией -->
      <div class="border-l border-white pl-6 lg:pl-12 space-y-4 my-8">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-light tracking-wide text-white">
          Máquina de café espresso manual con molinillo integrado
        </h1>
      </div>

      <!-- Аккордеон вопросов и ответов -->
      <div class="space-y-4 pt-4 max-w-250 mx-auto">
        {questions.map((item, index) => (
          <details 
            class="group bg-[#141414] border border-neutral-800/80 rounded-none transition-all duration-300 overflow-hidden open:bg-[#161616]"
            open={index === 0}
          >
            <summary class="flex items-center justify-between py-8 px-6 sm:px-10 cursor-pointer list-none select-none">
              <h2 class="text-base sm:text-lg lg:text-xl font-light text-white tracking-wide pr-6 group-open:font-normal">
                {item.question}
              </h2>

              <!-- Иконка плюса / минуса -->
              <div class="text-neutral-400 group-hover:text-white transition-colors shrink-0">
                <svg 
                  class="w-5 h-5 transition-transform duration-300 group-open:rotate-180" 
                  fill="none" 
                  stroke="currentColor" 
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
            </summary>

            <div class="px-6 sm:px-10 pb-8 pt-2 text-neutral-300 text-sm sm:text-base font-light leading-relaxed border-t border-neutral-800/60 mt-2 space-y-4">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>

    </div>
  </main>
</Layout>