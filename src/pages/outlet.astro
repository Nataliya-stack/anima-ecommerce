---
// src/pages/outlet.astro
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";

// Импортируем рабочую SQL-функцию из слоя данных
import { obtenerProductosOutlet } from "../lib/productos";

// 1. ПОЛУЧАЕМ ВСЕ ТОВАРЫ СО СКИДКАМИ ИЗ БАЗЫ ДАННЫХ
const products = (await obtenerProductosOutlet()) || [];

// 2. СОРТИРУЕМ И ФИЛЬТРУЕМ ТОВАРЫ ДЛЯ КАТЕГОРИЙ И СПЕЦ-БЛОКОВ
// Фильтруем по колонке 'type' из Supabase
const grandesElectro = products.filter((p: any) => p.type === "gran");
const pequenosElectro = products.filter((p: any) => p.type === "pequeno");

// Блок "Últimas Unidades" — берем товары, где stock < 5 (на скриншоте у фритюрницы stock=1, она идеально встанет сюда)
const ultimasUnidades = products.filter((p: any) => p.stock > 0 && p.stock < 5);

// Секция "Productos de Exposición" — искусственно выделим духовой шкаф (id=2), так как духовые шкафы чаще всего стоят на витринах
const productosExposicion = products.filter(
  (p: any) => p.pk_producto === 2 || p.pk_producto === 6,
);

// Цветовая гамма рамок для карточек Аутлета
const colorBordeActual = "#a70007";
---

<Layout title="Outlet Oficial | ÁNIMA">
  <!-- ===================================================================== -->
  <!-- ГЛАВНЫЙ КОНТЕЙНЕР СТРАНИЦЫ                                         -->
  <!-- ===================================================================== -->
  <main
    class="w-full min-h-screen bg-[#fcfcfc] text-[#141414] pt-35 lg:pt-55 pb-12 lg:pb-24 font-sans"
  >
    <!-- Возврат на главную страницу -->
    <div class="w-full max-w-[1700px] mx-auto px-6 sm:px-12 lg:px-20 mb-6">
      <nav
        class="text-[14px] lg:tracking-[0.2em] text-neutral-400 uppercase font-light font-sans select-none"
      >
        <a href="/" class="hover:text-black transition-colors"
          >Página principal</a
        >
        <span class="mx-1">/</span>
      </nav>
    </div>

    <!-- 2. НОВЫЙ МИНИМАЛИСТИЧНЫЙ ВЕРХНИЙ БАННЕР -->
    <section class="w-full max-w-[1700px] mx-auto px-6 sm:px-12 lg:px-20 mb-20">
      <div
        class="bg-white border border-neutral-100 p-8 sm:p-12 lg:p-16 rounded-sm shadow-sm grid grid-cols-1 lg:grid-cols-[45%_55%] gap-8 items-center"
      >
        <div class="space-y-4">
          <span
            class="text-xs uppercase tracking-[0.3em] text-red-600 font-semibold block"
            >Oportunidades Únicas</span
          >
          <h1
            class="text-4xl sm:text-5xl lg:text-[56px] font-light tracking-wide uppercase leading-none text-neutral-900"
          >
            ÁNIMA Outlet
          </h1>
          <div class="w-16 h-px bg-red-600 my-4"></div>
        </div>
        <div class="text-left">
          <p
            class="text-neutral-600 text-sm lg:text-base font-light tracking-wide leading-relaxed"
          >
            Descubre piezas icónicas de diseño exclusivo con condiciones
            excepcionales. Una selección rigurosa de modelos descatalogados,
            últimas unidades en stock o productos de exposición con un
            rendimiento tecnológico impecable и completa garantía oficial. El
            lujo italiano, ahora más accesible.
          </p>
        </div>
      </div>
    </section>

    <!-- ГЛАВНЫЙ КОНТЕНТ СТРАНИЦЫ -->
    <section
      class="w-full max-w-[1700px] mx-auto px-6 sm:px-12 lg:px-20 space-y-28"
    >
      <!-- ========================================== -->
      <!-- РАЗДЕЛ 1: СЕТКА КАТЕГОРИЙ С МАКС. СКИДКАМИ -->
      <!-- ========================================== -->
      <div class="w-full block">
        <div class="mb-10 text-left">
          <h2
            class="text-xl sm:text-2xl font-light uppercase tracking-wider text-neutral-800"
          >
            1. Categorías en Promoción
          </h2>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mt-1">
            Explora por tipo de electrodoméstico
          </p>
        </div>

        <!-- Красивая навигационная сетка по категориям -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 select-none">
          <!-- Категория 1 -->
          <div
            class="bg-white border border-neutral-100 p-8 rounded-sm text-left shadow-sm flex flex-col justify-between h-48 hover:border-red-600/30 transition-all"
          >
            <div>
              <h3
                class="text-lg font-medium text-neutral-900 uppercase tracking-wide"
              >
                Grandes Electrodomésticos
              </h3>
              <p class="text-xs text-neutral-400 font-light mt-1">
                Frigoríficos, hornos, lavavajillas
              </p>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="text-2xl font-light text-red-600 tracking-tight"
                >Hasta -30%</span
              >
              <a
                href="#grandes-section"
                class="text-xs uppercase font-bold tracking-wider border-b border-black pb-0.5 hover:opacity-60 transition-all"
                >Ver todos</a
              >
            </div>
          </div>
          <!-- Категория 2 -->
          <div
            class="bg-white border border-neutral-100 p-8 rounded-sm text-left shadow-sm flex flex-col justify-between h-48 hover:border-red-600/30 transition-all"
          >
            <div>
              <h3
                class="text-lg font-medium text-neutral-900 uppercase tracking-wide"
              >
                Pequeños Electrodomésticos
              </h3>
              <p class="text-xs text-neutral-400 font-light mt-1">
                Tostadoras, hervidores, batidoras
              </p>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="text-2xl font-light text-red-600 tracking-tight"
                >Hasta -40%</span
              >
              <a
                href="#pequenos-section"
                class="text-xs uppercase font-bold tracking-wider border-b border-black pb-0.5 hover:opacity-60 transition-all"
                >Ver todos</a
              >
            </div>
          </div>
          <!-- Категория 3 -->
          <div
            class="bg-white border border-neutral-100 p-8 rounded-sm text-left shadow-sm flex flex-col justify-between h-48 hover:border-red-600/30 transition-all"
          >
            <div>
              <h3
                class="text-lg font-medium text-neutral-900 uppercase tracking-wide"
              >
                Menaje y Accesorios
              </h3>
              <p class="text-xs text-neutral-400 font-light mt-1">
                Café, menaje de cocina y piezas
              </p>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="text-2xl font-light text-red-600 tracking-tight"
                >Hasta -50%</span
              >
              <span
                class="text-xs uppercase font-light text-neutral-400 tracking-widest"
                >Próximamente</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- РАЗДЕЛ 2: ПРОДУКТЫ С ВИТРИНЫ (EXPOSICIÓN)   -->
      <!-- ========================================== -->
      {
        productosExposicion.length > 0 && (
          <div class="w-full block">
            <div class="flex items-center justify-between mb-10 border-b border-neutral-100 pb-4 text-left">
              <div>
                <h2 class="text-xl sm:text-2xl font-light uppercase tracking-wider text-neutral-800">
                  2. Productos de Exposición
                </h2>
                <p class="text-xs text-neutral-500 font-light tracking-wide mt-1">
                  Aparatos en perfecto estado estético y funcional que han
                  formado parte de muestras de diseño o ferias.
                </p>
              </div>
              <span class="text-xs uppercase tracking-widest text-red-600 font-medium whitespace-nowrap bg-red-50 px-3 py-1 rounded-full hidden sm:inline-block">
                Garantía completa
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 xl:gap-16">
              {productosExposicion.map((item: any) => (
                <ProductCard product={item} bordeColor={colorBordeActual} />
              ))}
            </div>
          </div>
        )
      }

      <!-- ========================================== -->
      <!-- РАЗДЕЛ 3: ПОСЛЕДНИЕ ЭКЗЕМПЛЯРЫ (STOCK 1-2) -->
      <!-- ========================================== -->
      {
        ultimasUnidades.length > 0 && (
          <div class="w-full block">
            <div class="flex items-center justify-between mb-10 border-b border-neutral-100 pb-4 text-left">
              <div>
                <h2 class="text-xl sm:text-2xl font-light uppercase tracking-wider text-neutral-800 flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse" />{" "}
                  3. Últimas Unidades
                </h2>
                <p class="text-xs text-neutral-500 font-light tracking-wide mt-1">
                  Últimos artículos disponibles en nuestro almacén central antes
                  de fin de existencias.
                </p>
              </div>
              <span class="text-xs uppercase tracking-widest text-neutral-400 font-mono hidden sm:inline-block">
                Falta de Stock
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 xl:gap-16">
              {ultimasUnidades.map((item: any) => (
                <ProductCard product={item} bordeColor={colorBordeActual} />
              ))}
            </div>
          </div>
        )
      }

      <!-- ========================================== -->
      <!-- РАЗДЕЛ 4: СЕТКИ КАТЕГОРИЙ ТОВАРОВ ИЗ БАЗЫ  -->
      <!-- ========================================== -->

      <!-- 4.1. Крупная бытовая техника -->
      <div id="grandes-section" class="w-full block scroll-mt-32">
        <div
          class="flex items-center justify-between mb-10 border-b border-neutral-100 pb-4 text-left"
        >
          <h2
            class="text-xl sm:text-2xl font-light uppercase tracking-wider text-neutral-800"
          >
            Grandes Electrodomésticos en Oferta
          </h2>
          <span class="text-xs uppercase tracking-widest text-neutral-400">
            {grandesElectro.length} artículos
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 xl:gap-16">
          {
            grandesElectro.map((item: any) => (
              <ProductCard product={item} bordeColor={colorBordeActual} />
            ))
          }
        </div>
      </div>

      <!-- 4.2. Малая бытовая техника -->
      <div id="pequenos-section" class="w-full block scroll-mt-32">
        <div
          class="flex items-center justify-between mb-10 border-b border-neutral-100 pb-4 text-left"
        >
          <h2
            class="text-xl sm:text-2xl font-light uppercase tracking-wider text-neutral-800"
          >
            Pequeños Electrodomésticos en Oferta
          </h2>
          <span class="text-xs uppercase tracking-widest text-neutral-400">
            {pequenosElectro.length} artículos
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 xl:gap-16">
          {
            pequenosElectro.map((item: any) => (
              <ProductCard product={item} bordeColor={colorBordeActual} />
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- РАЗДЕЛ 5: ИНФОРМАЦИОННЫЙ БЛОК FAQ          -->
    <!-- ========================================== -->
    <section class="w-full border-t border-neutral-100 pt-20">
      <div class="max-w-4xl mx-auto text-left">
        <h2
          class="text-2xl font-light uppercase tracking-wider text-neutral-800 text-center mb-12"
        >
          Preguntas Frecuentes sobre el Outlet
        </h2>

        <!-- Сетка карточек с вопросами и ответами -->
        <div class="space-y-6">
          <!-- Вопрос 1 -->
          <div
            class="bg-white border border-neutral-100 p-6 rounded-sm shadow-sm"
          >
            <h4 class="text-base font-semibold text-neutral-900 mb-2">
              ¿Los productos del Outlet tienen garantía oficial?
            </h4>
            <p class="text-sm text-neutral-600 font-light leading-relaxed">
              Sí, absolutamente. Todos los electrodomésticos disponibles en
              nuestro Outlet, incluidos los modelos de exposición y últimas
              unidades, cuentan con la misma garantía oficial íntegra del
              fabricante que un producto de catálogo habitual.
            </p>
          </div>

          <!-- Вопрос 2 -->
          <div
            class="bg-white border border-neutral-100 p-6 rounded-sm shadow-sm"
          >
            <h4 class="text-base font-semibold text-neutral-900 mb-2">
              ¿Cuál es el estado de los "Productos de Exposición"?
            </h4>
            <p class="text-sm text-neutral-600 font-light leading-relaxed">
              Son aparatos que han estado expuestos de forma estática en ferias
              de diseño o en nuestros showrooms oficiales. Nunca han sido
              encendidos para cocinar. Su estado mecánico es del 100% y ellos
              pasan por una completa revisión técnica preventa por parte de
              nuestros especialistas.
            </p>
          </div>

          <!-- Вопрос 3 -->
          <div
            class="bg-white border border-neutral-100 p-6 rounded-sm shadow-sm"
          >
            <h4 class="text-base font-semibold text-neutral-900 mb-2">
              ¿Cómo funciona la entrega y el transporte de estos artículos?
            </h4>
            <p class="text-sm text-neutral-600 font-light leading-relaxed">
              El envío se gestiona bajo las mismas condiciones premium de
              nuestra tienda. Los grandes electrodomésticos incluyen transporte
              especializado, desembalaje y conexión básica en tu domicilio,
              garantizando la seguridad en el traslado.
            </p>
          </div>

          <!-- Вопрос 4 -->
          <div
            class="bg-white border border-neutral-100 p-6 rounded-sm shadow-sm"
          >
            <h4 class="text-base font-semibold text-neutral-900 mb-2">
              ¿Se pueden realizar devoluciones de artículos Outlet?
            </h4>
            <p class="text-sm text-neutral-600 font-light leading-relaxed">
              Sí, las compras realizadas en la sección de Outlet están cubiertas
              por la normativa vigente de desestimación y devoluciones
              comerciales de la plataforma, protegiendo tus derechos
              íntegramente como comprador.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
