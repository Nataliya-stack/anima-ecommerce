---
// src/pages/guia-batidora.astro
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import imgHeroBatidora from "../assets/categories/batidora_baner.jpg";
---

<Layout title="Guía Batidora de Alto Rendimiento | ÁNIMA">
  <main
    class="w-full min-h-screen bg-white text-neutral-950 font-sans pb-40 select-none pt-35 lg:pt-50"
  >
    <!-- ======================================================= -->
    <!-- 1. ПОЛНОЭКРАННЫЙ ГЛАВНЫЙ БАННЕР -->
    <!-- ======================================================= -->
    <section
      class="component is-herobanner-slider relative w-full aspect-192/95 md:aspect-192/58 bg-[#f7f7f7] overflow-hidden select-none"
    >
      <!-- ЕДИНАЯ КАРТИНКА-ФОН -->
      <div class="absolute inset-0 w-full h-full z-0">
        <Image
          src={imgHeroBatidora}
          alt="BLC Batidora de alto rendimiento - Smeg"
          class="w-full h-full object-cover object-center opacity-100"
        />
      </div>

      <!-- НАВИГАЦИОННЫЕ СТРЕЛКИ  -->
      <div class="absolute top-6 left-0 w-full px-6 md:px-16 z-20">
        <nav
          class="max-w-[1700px] mx-auto text-[14px] lg:tracking-[0.2em] text-neutral-400 uppercase font-light font-sans select-none flex items-center gap-2"
        >
          <a
            href="/"
            class="hover:text-black transition-colors flex items-center gap-1"
          >
            ← Página principal
          </a>
          <span class="mx-1">/</span>
          <a
            href="/asistencia-tecnica"
            class="hover:text-black transition-colors"
          >
            Asistencia técnica
          </a>
          <span class="mx-1">/</span>
          <span class="text-neutral-800 font-normal">Guía Batidora</span>
        </nav>
      </div>

      <!-- БЛОК ТЕКСТА -->
      <div
        class="absolute inset-0 w-full h-full z-10 flex items-center px-6 md:px-16"
      >
        <div class="w-full max-w-[1700px] mx-auto flex justify-start">
          <div
            class="w-full sm:max-w-100 md:max-w-[45%] text-left space-y-4 md:space-y-6"
          >
            <h1
              class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-light tracking-wide uppercase text-black leading-tight"
            >
              Guía del usuario de la Batidora de alto rendimiento
            </h1>
            <p
              class="text-xs sm:text-sm md:text-base text-neutral-700 font-light tracking-wide leading-relaxed max-w-[90%]"
            >
              Si ha adquirido una <span class="font-medium text-black"
                >batidora de vaso de alto rendimiento</span
              >, lo único que tiene sentido hacer — empezar a batir. Siga la <span
                class="font-medium text-black">guía completa</span
              > sobre cómo utilizar la batidora.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================= -->
    <!-- 2. НИЖНИЙ БЛОК-ОПИСАНИЕ НА БЕЛОМ ФОНЕ -->
    <!-- ======================================================= -->
    <div
      class="w-full bg-white px-6 md:px-16 border-t border-neutral-300 py-12 text-left z-20 relative"
    >
      <div class="w-full max-w-[1700px] mx-auto">
        <p
          class="text-base text-neutral-800 tracking-wide font-light leading-relaxed"
        >
          Descubra la mejor manera de utilizar su batidora de alto rendimiento
          con el
          <span
            class="font-medium underline underline-offset-4 cursor-pointer hover:text-neutral-500 transition-colors"
            >servicio individual y familiar</span
          >, la <span
            class="font-medium underline underline-offset-4 cursor-pointer hover:text-neutral-500 transition-colors"
            >función pulse</span
          >, la <span
            class="font-medium underline underline-offset-4 cursor-pointer hover:text-neutral-500 transition-colors"
            >limpieza automática</span
          >
          y el accesorio <span
            class="font-medium underline underline-offset-4 cursor-pointer hover:text-neutral-500 transition-colors"
            >bomba de vacío</span
          >.
        </p>
      </div>
    </div>

    <!-- ======================================================= -->
    <!-- 3. СЕКЦИЯ С 4 ДИЗАЙНЕРСКИМИ ВИДЕО-БЛОКАМИ -->
    <!-- ======================================================= -->
    <section
      class="w-full max-w-[1700px] mx-auto px-6 md:px-16 pt-36 space-y-40 flex flex-col items-center"
    >
      <!-- ВИДЕО 1: SERVICIO INDIVIDUAL O FAMILIAR -->
      <div
        class="flex flex-col lg:flex-row items-start lg:items-center gap-12 lg:gap-20 w-full"
      >
        <div class="w-full lg:w-[35%] space-y-6 text-left shrink-0">
          <h2
            class="text-3xl sm:text-4xl font-light tracking-wide uppercase text-black"
          >
            Servicio Individual<br />o Familiar
          </h2>
          <div
            class="text-base text-neutral-600 font-light tracking-wide space-y-4 leading-relaxed"
          >
            <p>
              Los modos de servicio <span class="font-medium text-black"
                >Individual y Familiar</span
              > permiten utilizar la batidora con <span
                class="font-medium text-black"
                >cantidades para una sola ración</span
              > -Servicio individual- o <span class="font-medium text-black"
                >varias raciones</span
              > -Servicio familiar- para ahorrar tiempo y energía en las preparaciones.
            </p>
            <p>
              Ambos modos de servicio pueden activarse sólo para los programas
              preestablecidos <span class="font-medium text-black"
                >Smoothie, Green Smoothie y Postres Congelados</span
              >.
            </p>
            <p class="text-sm text-neutral-400 font-normal tracking-wide pt-4">
              Vea el vídeo para descubrir cómo utilizarlos.
            </p>
          </div>
        </div>
        <div
          class="w-full lg:w-[65%] aspect-video bg-neutral-100 border border-neutral-200 overflow-hidden relative shrink-0 shadow-2xs"
        >
          <video 
  src="/video/servicio.mp4"
  controls 
  preload="metadata"
  class="w-full h-full object-cover"
>
  Tu navegador no soporta vídeos.
</video>
        </div>
      </div>

      <!-- ВИДЕО 2: FUNCIÓN PULSE -->
      <div
        class="flex flex-col lg:flex-row items-start lg:items-center gap-12 lg:gap-20 w-full"
      >
        <div class="w-full lg:w-[35%] space-y-6 text-left shrink-0">
          <h2
            class="text-3xl sm:text-4xl font-light tracking-wide uppercase text-black"
          >
            Función Pulse
          </h2>
          <div
            class="text-base text-neutral-600 font-light tracking-wide space-y-4 leading-relaxed"
          >
            <p>
              La <span class="font-medium text-black">función Pulse</span> permite
              controlar perfectamente la duración y la frecuencia del batido para
              <span class="font-medium text-black"
                >personalizar texturas y preparaciones</span
              > hasta alcanzar la consistencia deseada.
            </p>
            <p>
              La función Pulse puede activarse en modo manual (velocidad 1-9) o
              de forma autónoma.
            </p>
          </div>
        </div>
        <div
          class="w-full lg:w-[65%] aspect-video bg-neutral-100 border border-neutral-200 overflow-hidden shrink-0 shadow-2xs"
        >
          <video 
  src="/video/pulse.mp4"
  controls 
  preload="metadata"
  class="w-full h-full object-cover"
>
  Tu navegador no soporta vídeos.
</video>
        </div>
      </div>

      <!-- ВИДЕО 3: AUTO LIMПIEZA -->
      <div
        class="flex flex-col lg:flex-row items-start lg:items-center gap-12 lg:gap-20 w-full"
      >
        <div class="w-full lg:w-[35%] space-y-6 text-left shrink-0">
          <h2
            class="text-3xl sm:text-4xl font-light tracking-wide uppercase text-black"
          >
            Auto Limpieza
          </h2>
          <div
            class="text-base text-neutral-600 font-light tracking-wide space-y-4 leading-relaxed"
          >
            <p>
              La función de <span class="font-medium text-black"
                >limpieza automática</span
              > permite limpiar la jarra fácil y rápidamente después de cada uso,
              lo que <span class="font-medium text-black"
                >facilita la preparación de varias recetas seguidas</span
              >.
            </p>
          </div>
        </div>
        <div
          class="w-full lg:w-[65%] aspect-video bg-neutral-100 border border-neutral-200 overflow-hidden shrink-0 shadow-2xs"
        >
          <video 
  src="/video/limpieza.mp4"
  controls 
  preload="metadata"
  class="w-full h-full object-cover"
>
  Tu navegador no soporta vídeos.
</video>
        </div>
      </div>

      <!-- ВИДЕО 4: ACCESORIO BOMBA DE VACÍО -->
      <div
        class="flex flex-col lg:flex-row items-start lg:items-center gap-12 lg:gap-20 w-full"
      >
        <div class="w-full lg:w-[35%] space-y-6 text-left shrink-0">
          <h2
            class="text-3xl sm:text-4xl font-light tracking-wide uppercase text-black"
          >
            Accesorio Bomba<br />de Vacío
          </h2>
          <div
            class="text-base text-neutral-600 font-light tracking-wide space-y-4 leading-relaxed"
          >
            <p>
              La <span class="font-medium text-black">bomba de vacío</span> elimina
              el aire de la jarra, evitando el contacto con los ingredientes y <span
                class="font-medium text-black">reduciendo la oxidación</span
              >, lo que da como resultado <span class="font-medium text-black"
                >colores más brillantes, sabores más sabrosos y texturas más
                suaves</span
              >.
            </p>
            <p>
              Es fácil activar la bomba de vacío gracias a unos sencillos pasos.
            </p>
          </div>
        </div>
        <div
          class="w-full lg:w-[65%] aspect-video bg-neutral-100 border border-neutral-200 overflow-hidden shrink-0 shadow-2xs"
        >
          <video 
  src="/video/vacio.mp4"
  controls 
  preload="metadata"
  class="w-full h-full object-cover"
>
  Tu navegador no soporta vídeos.
</video>
        </div>
      </div>
    </section>
  </main>
</Layout>
