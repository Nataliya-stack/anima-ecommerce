---
// src/components/ProductCard.astro
interface Props {
  product: any;
  bordeColor: string; // Принимаем динамический цвет рамки со страницы каталога
}

const { product, bordeColor } = Astro.props;

const imagenValida = product.url_imagen || "/placeholder-smeg.jpg";
---

<!-- ======================================================== -->
<!-- 1. БЛОК: ВЕРХНЯЯ СЛУЖЕБНАЯ ПАНЕЛЬ                        -->
<!-- ======================================================== -->
<section
  class="flex flex-col bg-white rounded-3xl overflow-hidden group select-none relative p-6 border transition-all duration-500 hover:shadow-md h-full w-full"
  style={`border-color: ${bordeColor};`}
>
  <!-- ======================================================== -->
  <!-- ВЕРХНЯЯ СЛУЖЕБНАЯ ПАНЕЛЬКА                               -->
  <!-- ======================================================== -->
  <div class="w-full flex items-center justify-between mb-4 z-20">
    <button
      class="flex items-center gap-2 text-xs font-light text-neutral-500 hover:opacity-80 transition-colors cursor-pointer focus:outline-none"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M7.5 21 3-16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"
        ></path>
      </svg>
      Comparación
    </button>

    <a
      href={`/product/${product.pk_producto}`}
      class="text-white text-[11px] font-medium tracking-wide uppercase px-4 py-1.5 rounded-full hover:opacity-90 transition-opacity shadow-xs"
      style={`background-color: ${bordeColor};`}
    >
      Reservar
    </a>
  </div>

  <!-- ======================================================== -->
  <!-- КРУПНЫЙ КОНТЕЙНЕР ФОТОГРАФИИ                             -->
  <!-- ======================================================== -->
  <div
    class="w-full aspect-4/3 bg-neutral-100 rounded-2xl overflow-hidden relative mb-6 flex items-center justify-center p-0"
  >
    <img
      src={imagenValida}
      alt={product.nombre_producto}
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-102 opacity-95"
      loading="lazy"
    />

    {
      product.eficiencia_energetica && (
        <span class="absolute bottom-3 left-3 z-10 text-[9px] font-bold bg-white text-emerald-600 border border-neutral-100 px-2 py-0.5 rounded-sm uppercase tracking-wider shadow-xs">
          {product.eficiencia_energetica}
        </span>
      )
    }
  </div>

  <!-- ======================================================== -->
  <!-- СВЕДЕНИЯ О ТОВАРЕ                                        -->
  <!-- ======================================================== -->
  <div class="flex flex-col text-left flex-1 grow justify-between">
    <div class="space-y-2 mb-6">
      <h3
        class="text-xl font-bold tracking-tight transition-opacity line-clamp-2 group-hover:opacity-80 leading-snug"
        style={`color: ${bordeColor};`}
      >
        {product.nombre_producto}
      </h3>

      <p
        class="text-[13px] text-neutral-500 font-light tracking-wide leading-relaxed line-clamp-2 min-h-10"
      >
        {product.descripcion_producto}
      </p>
    </div>

    <!-- ======================================================== -->
    <!-- НИЖНЯЯ ПАНЕЛЬ: ЦЕНА                                      -->
    <!-- ======================================================== -->
    <div
      class="flex items-end justify-between pt-4 border-t border-neutral-100 mt-auto"
    >
      <div class="flex flex-col">
        <span
          class="text-xl font-bold font-mono tracking-tight"
          style={`color: ${bordeColor};`}
        >
          {
            typeof product.precio === "number"
              ? product.precio.toFixed(2)
              : product.precio
          } €
        </span>
        {
          Number(product.descuento) > 0 && (
            <span class="text-[11px] text-red-500 font-normal mt-0.5">
              Oferta -{product.descuento}% incl.
            </span>
          )
        }
      </div>

      <span
        class="text-[10px] tracking-widest uppercase text-neutral-400 font-medium"
      >
        {product.type === "gran" ? "Gran El." : "Pequeño El."}
      </span>
    </div>
  </div>
</section>
